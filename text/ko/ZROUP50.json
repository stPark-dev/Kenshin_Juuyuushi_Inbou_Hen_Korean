  "note": ""
 },
 "ZROUP50:3ebb4": {
  "src_hash": "50a0be2fc58f",
  "ko": "켄신^c　지금 해야 할 일은 카미즈메 사람이라는 말의 뜻을 알아보는 것이 아니겠소．",
  "status": "draft",
  "note": ""
 },
