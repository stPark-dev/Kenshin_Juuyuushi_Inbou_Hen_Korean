  "note": ""
 },
 "ZROUP50:3ea84": {
  "src_hash": "1aaa21e7d41f",
  "ko": "사노스케^c　어이어이，딴 길로 새는 거냐？^c　뭐，난 상관없지만．",
  "status": "draft",
  "note": ""
 },
 "ZROUP50:3eac4": {
  "src_hash": "121f438ccd89",
  "ko": "카오루^c　메구미 씨라면 뭔가 알지도 몰라．",
  "status": "draft",
  "note": ""
 },
