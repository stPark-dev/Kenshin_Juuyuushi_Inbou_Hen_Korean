{
 "RU12:161": {
  "speaker": "카오루",
  "ko": "불온한 그림자라니……\n무슨 뜻이야，켄신？",
  "status": "draft",
  "note": ""
 },
 "RU12:243": {
  "speaker": "켄신",
  "ko": "그걸 모르기에 알아보러 가오．\n걱정할 것 없소．",
  "status": "draft",
  "note": ""
 },
 "RU12:313": {
  "speaker": "카오루",
  "ko": "으……응．",
  "status": "draft",
  "note": ""
 },
 "RU12:393": {
  "speaker": "카오루",
  "ko": "이 나라에 또 동란의 예감이라니．\n켄신의 감은 잘 맞지만……．",
  "status": "draft",
  "note": ""
 },
 "RU12:567": {
  "speaker": "야히코",
  "ko": "어라？ 어디 가는 거야？ 오늘 밥은\n어쩌라고．",
  "status": "draft",
  "note": ""
 },
 "RU12:625": {
  "speaker": "켄신",
  "ko": "미안하지만 밥은 카오루 공에게\n부탁하시오．소인，한동안 여행을\n떠나야 하오．",
  "status": "draft",
  "note": ""
 },
 "RU12:696": {
  "speaker": "야히코",
  "ko": "여행！？",
  "status": "draft",
  "note": ""
 },
 "RU12:717": {
  "speaker": "야히코",
  "ko": "앗，어이！！",
  "status": "draft",
  "note": ""
 },
 "RU12:831": {
  "speaker": "사노스케",
  "ko": "어이，켄신 아니냐．어디 가냐？",
  "status": "draft",
  "note": ""
 },
 "RU12:867": {
  "speaker": "켄신",
  "ko": "눈치챘을 것이오．요즘 이 마을을\n사악한 기운이 뒤덮고 있음을．",
  "status": "draft",
  "note": ""
 },
 "RU12:944": {
  "speaker": "사노스케",
  "ko": "흐음……．왠지 재밌는 일이\n벌어지려나 보군．",
  "status": "draft",
  "note": ""
 }
}